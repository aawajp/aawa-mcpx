{
	"name": "aawa-mcpx",
	"version": "0.1.0",
	"description": "MCP gateway that aggregates multiple backends behind one Streamable HTTP endpoint.",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"css": "tailwindcss -i ./src/ui/index.css -o ./.tailwind/index.css",
		"css:watch": "tailwindcss -i ./src/ui/index.css -o ./.tailwind/index.css --watch=always",
		"dev": "bun run css && bun run --parallel css:watch dev:server",
		"dev:server": "NODE_ENV=development bun --hot src/server/index.ts",
		"test": "bun test",
		"lint": "bun check && biome check --fix"
	},
	"trustedDependencies": [],
	"dependencies": {
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"arktype": "2.2.9",
		"clsx": "2.1.1",
		"jose": "6.2.13",
		"openid-client": "6.8.8",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@modelcontextprotocol/client": "2.3.1",
		"@tailwindcss/cli": "4.3.3",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0"
	}
}
