{
	// https://next.biomejs.dev/reference/configuration/
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"root": true,
	"vcs": {
		"enabled": false
		// "enabled": true,
		// "clientKind": "git",
		// "useIgnoreFile": true,
		// "defaultBranch": "main"
	},
	"files": {
		"includes": [
			"*.ts",
			"*.json",
			"*.jsonc",
			"src/**/*.ts",
			"src/**/*.tsx",
			"src/**/*.css",
			"src/**/*.json",
			"src/**/*.html"
		],
		"ignoreUnknown": true,
		"maxSize": 524288 // 512kB; ignore files bigger than this
	},
	"linter": {
		"enabled": true,
		"domains": {
			// disable at root and enable for those modules that need them
			"project": "all",
			"react": "all",
			"test": "all",
			"types": "all"
		},
		"rules": {
			"correctness": {
				"noUndeclaredDependencies": "warn",
				"noUnusedFunctionParameters": "warn",
				"noUnusedImports": "warn",
				"noUnusedLabels": "warn",
				"noUnusedPrivateClassMembers": "warn",
				"noUnusedVariables": "warn",
				"noUnresolvedImports": "off", // unnecessary when using tsc
				"useImportExtensions": "off"
			},
			"performance": {
				"noJsxPropsBind": "off" // no component is memoized, so new handler identities cost nothing
			},
			"style": {
				"noExportedImports": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"./**",
											"../**",
											"!**/*.{json,jsonc,css,html,svg,png,jpg,jpeg,webp,gif,ico,txt,md,sql,csv,toml,yaml,yml}"
										],
										"message": "Use the @/ alias for code imports; relative paths are only for non-code files such as JSON, CSS and HTML."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"bun:sqlite": "UI code must not access the database."
								},
								"patterns": [
									{
										"group": [
											"./**",
											"../**",
											"!**/*.{json,jsonc,css,html,svg,png,jpg,jpeg,webp,gif,ico,txt,md,sql,csv,toml,yaml,yml}"
										],
										"message": "Use the @/ alias for code imports; relative paths are only for non-code files such as JSON, CSS and HTML."
									},
									{
										"group": ["@/server/**", "node:*"],
										"message": "UI code may import only @/shared and @/ui."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"bun:sqlite": "shared/ must not access the database.",
									"react": "shared/ must not depend on React.",
									"react-dom": "shared/ must not depend on React."
								},
								"patterns": [
									{
										"group": [
											"./**",
											"../**",
											"!**/*.{json,jsonc,css,html,svg,png,jpg,jpeg,webp,gif,ico,txt,md,sql,csv,toml,yaml,yml}"
										],
										"message": "Use the @/ alias for code imports; relative paths are only for non-code files such as JSON, CSS and HTML."
									},
									{
										"group": ["@/ui/**", "@/server/**"],
										"message": "shared/ must not import from other layers."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":URL:",
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							":NODE:",
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"trailingNewline": true
	},
	"javascript": {
		"parser": {
			"jsxEverywhere": false
		},
		"formatter": {
			"enabled": true,
			"quoteProperties": "preserve",
			"quoteStyle": "single"
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	}
}
