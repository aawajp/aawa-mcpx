# Roles (comma-separated) that may log in to the dashboard. Required with ENABLE_OIDC=true.
ADMIN_ROLES=

# Host names clients and the dashboard use (comma-separated); other hosts get HTTP 403. Required.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],host.docker.internal

# Login through an OIDC identity provider, for the dashboard and /mcp; see README "Authentication". Settings marked "with ENABLE_OIDC=true" are ignored when false.
ENABLE_OIDC=false

# Superadmin login for the dashboard; see README "Authentication". With both ENABLE_SUPERADMIN and ENABLE_OIDC false, the dashboard and /mcp are unprotected (highly discouraged). When exposed to the internet, use OIDC and set this to false (highly recommended). Settings marked "with ENABLE_SUPERADMIN=true" are ignored when false.
ENABLE_SUPERADMIN=true

# Retained 2025 MCP sessions per user and client name and version; the oldest is dropped beyond it.
MCP_MAX_SESSIONS_PER_CLIENT=10

# Retained 2025 MCP sessions per user, of all clients; the user's oldest is dropped beyond it.
MCP_MAX_SESSIONS_PER_USER=100

# Runtime mode, set by `bun run dev` and compose.yaml, not here; see README "Environment".
# NODE_ENV=

# Audience (`aud`) that OAuth access tokens on /mcp must name. Required with ENABLE_OIDC=true.
OIDC_AUDIENCE=

# Dashboard client ID at the identity provider (IdP). Required with ENABLE_OIDC=true.
OIDC_CLIENT_ID=

# Dashboard client secret, sent with HTTP Basic authentication. Required with ENABLE_OIDC=true.
OIDC_CLIENT_SECRET=

# IdP issuer URL, discovered at startup; https unless on localhost. Required with ENABLE_OIDC=true.
OIDC_ISSUER=

# Token claim with the user's roles: a list of role names or an object keyed by role. Required with ENABLE_OIDC=true.
OIDC_ROLES_CLAIM=

# Scopes (comma-separated) that the dashboard login, MCP clients and OIDC API keys request, including any the IdP needs to put roles in tokens.
OIDC_SCOPES=openid,profile,offline_access

# Listening port.
PORT=4567

# Origin the browser uses for the dashboard; https unless on localhost. Required with ENABLE_OIDC=true or ENABLE_SUPERADMIN=true.
PUBLIC_URL=

# Hash of the superadmin's password, set in `.env.local`; create it with the command below (see README "Authentication"). Required with ENABLE_SUPERADMIN=true.
# bun -e 'console.log((await Bun.password.hash(prompt("Password:"))).replaceAll("$", "\x5c$"))'
SUPERADMIN_PASSWORD_HASH=

# Username of the superadmin's dashboard login, also its Name in the Users list. Required with ENABLE_SUPERADMIN=true.
SUPERADMIN_USERNAME=

# Dashboard session lifetime in seconds from its last use.
UI_SESSION_IDLE_TIMEOUT=3600

# Dashboard session lifetime in seconds from the login.
UI_SESSION_MAX_AGE=28800
